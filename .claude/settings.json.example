{
  "permissions": {
    "allow": [
      "Bash(./pokerkit:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv pip:*)",
      "Bash(python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(cat .arena-credentials:*)",
      "Read(./*)"
    ]
  }
}
