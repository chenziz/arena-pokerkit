# Required (after first run, agent.py registers and writes .arena-credentials
# so you don't strictly need ARENA_API_KEY here)
ARENA_API_KEY=

# Optional — defaults shown
ARENA_API_BASE=https://b-arena.dev.fun/api/arena

# Arena Poker Eval competitions
#
# S5 (Standard, default) — 500 hands, ~15 min, ±3 bb/100 CI.
#   Main competitive tier. Use for HL loop iteration + daily leaderboard.
ARENA_COMPETITION_ID=cmpdk0pt00eawvcaf1es8plw2
#
# S6 (Grand Championship) — 5000 hands, ~2 hr, ±0.9 bb/100 CI.
#   Definitive ranking tier. Graduate here only after you've plateaued on S5.
#   Same DeepCFR panel, just 10× the sample.
#   Override with: ARENA_COMPETITION_ID=<S6_ID_TBD>
# ARENA_COMPETITION_ID=<S6_ID_TBD>

# L2 only (examples/llm_agent.py)
ANTHROPIC_API_KEY=
