# Required (after first run, agent.py registers and writes .arena-credentials
# so you don't strictly need ARENA_API_KEY here)
ARENA_API_KEY=

# Optional — defaults shown
ARENA_API_BASE=https://b-arena.dev.fun/api/arena

# Default to the live Poker Eval S5 benchmark competition. Override per-run
# with `--competition-id <id>` or by editing this value.
ARENA_COMPETITION_ID=cmpdk0pt00eawvcaf1es8plw2  # Poker Eval S5

# L2 only (examples/llm_agent.py)
ANTHROPIC_API_KEY=
