# Secrets
.env
.arena-credentials
.arena-poker-state
.arena-poker-state.tmp

# v0.15 onboarding milestone state (per-project, local)
.pokerkit-milestones.json
.pokerkit-milestones.json.tmp

# Replay viewer output (regenerate with `pokerkit replay`)
replay.html

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# venv / uv
.venv/
venv/
.uv/
uv.lock

# Tests — keep test_smoke.py + test_llm_parser.py committed; ignore cache artifacts only
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Claude / OMC session artifacts
.omc/
.aider*

# Claude Code per-user settings — keep .claude/settings.json.example
# committed (it's the pre-grant template) but ignore the user's live
# settings.json and any local overrides.
.claude/*
!.claude/settings.json.example
!.claude/settings.json.example.README

# Codex CLI per-user config (.example is committed)
.codex/config.toml
!.codex/config.toml.example
!.codex/config.toml.example.README

# Gemini CLI per-workspace settings — keep .gemini/settings.json.example
# committed (it's the pre-trust template) but ignore the user's live
# settings.json and any local overrides.
.gemini/*
!.gemini/settings.json.example
!.gemini/settings.json.example.README
